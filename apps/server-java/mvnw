# -----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
# -----------------------------------------------------------------------------

set -euf
[ "${MVNW_VERBOSE-}" != true ] || set -x

# OS specific support.
native_path() { printf %s\\n "$1"; }
case "$(uname)" in
CYGWIN* | MINGW*)
  [ -z "${JAVA_HOME-}" ] || JAVA_HOME="$(cygpath --unix "$JAVA_HOME")"
  native_path() { cygpath --path --windows "$1"; }
  ;;
esac

# Resolve links - $0 may be a link
PRG="$0"
while [ -h "$PRG" ]; do
  ls=$(ls -ld "$PRG")
  link=$(expr "$ls" : '.*-> \(.*\)$')
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=$(dirname "$PRG")/$link
  fi
done
SAVED="$(pwd)"
cd "$(dirname "$PRG")" >/dev/null
MAVEN_PROJECTBASEDIR="$(pwd -P)"
cd "$SAVED" >/dev/null

MAVEN_WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_LAUNCHER=org.apache.maven.wrapper.MavenWrapperMain

if [ -r "$MAVEN_WRAPPER_JAR" ]; then
  if [ -z "${JAVA_HOME-}" ]; then
    JAVACMD=$(command -v java || true)
  else
    JAVACMD="$JAVA_HOME/bin/java"
  fi

  if [ ! -x "$JAVACMD" ] && ! command -v java >/dev/null 2>&1; then
    echo "错误: 未找到 Java。请先安装 JDK 17+，例如: brew install openjdk@17" >&2
    exit 1
  fi

  exec "$JAVACMD" \
    -classpath "$MAVEN_WRAPPER_JAR" \
    "-Dmaven.multiModuleProjectDirectory=${MAVEN_PROJECTBASEDIR}" \
    ${WRAPPER_LAUNCHER} "$@"
fi

echo "错误: 未找到 $MAVEN_WRAPPER_JAR" >&2
exit 1
